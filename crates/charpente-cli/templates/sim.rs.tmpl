//! Four properties, each honest: each asserts a claim that holds under ANY
//! fault schedule and gives up — rather than passing — in a run where
//! injected faults stopped it before the claim could be tested (GUIDE §8).
//! The notes, their bodies and their order are drawn with `sim.input()`, so a
//! failure shrinks to the fewest, simplest notes that still fail.
//!
//! Each property drives the app with `charpente_sim::drive` (GUIDE §8, "A
//! fault-free tail for an end-of-run check"), in four steps:
//! 1. Boot: the app boots through fault fallout, booting again as a
//!    supervisor would; a first boot that never gets past it leaves the
//!    faulted phase empty, and the run goes on.
//! 2. Faulted phase: the notes are posted through the production kernel loop
//!    under the run's faults. A fault ends the phase, not the run, and the
//!    replies already sent stand.
//! 3. Fault-free tail: a power cycle, the faults switched off, a clock
//!    refusal waited out, and the app booted again and run for a minute, so
//!    every due job drains.
//! 4. Re-send: the tail posts again every note the phase left unanswered, as
//!    a client that never saw its answer would.
//!
//! Run them: `charpente test --sim`. Watch one fail: delete the `tx.enqueue`
//! line in `src/lib.rs` and run again. Delete `tx.emit` and the third goes red;
//! turn `==` into `!=` in `add_note` and the fourth does.

use std::collections::BTreeMap;
use std::time::Duration;

use charpente::core::job::{JobRow, JobStatus};
use charpente::core::table::Codec;
use charpente::http::{App, Method, Request};
use charpente::{Id, View};
use charpente_sim::Sim;
use charpente_sim::checks::{dead_hooks_succeeded, durable_corruption_fired, events};
use charpente_sim::drive::{Drive, Recovered};
use {{ident}}::{Echo, NewNote, Note, NoteAdded, build_app};

charpente_sim::sim_tests! {
    acked_note_survives_a_restart require ["restart"],
    acked_post_implies_the_echo_after_recovery require ["restart"],
    acked_post_implies_its_event_after_recovery require ["restart"],
    a_resent_note_changes_nothing_and_a_conflict_is_refused require ["restart"],
}

/// The app on this run's disk. The drive calls it once per boot.
fn app(sim: &Sim) -> std::io::Result<App> {
    build_app(Box::new(sim.disk()), Box::new(sim.entropy()))
}

/// The recovered tail and each note the faulted phase acked, with its body.
type Acked = (Recovered, Vec<(u64, String)>);

/// POST 1-4 drawn notes (bodies and order drawn too) under faults, crash, and
/// recover in a fault-free tail. Returns the tail's kernel and each acked
/// note's id and body — the only notes there is a claim about. A note the
/// phase left unanswered may or may not have landed: the tail re-sends it,
/// and its answer is the tail's (`Recovered::resent`), so no claim names it.
/// `None` means the run was given up by name.
fn post_then_crash(sim: &mut Sim) -> Result<Option<Acked>, String> {
    let input = sim.input();
    let count = input.between("notes", 1, 4);
    let mut ids: Vec<u64> = (1..=count).collect();
    input.shuffle("order", &mut ids);
    let posts: Vec<(u64, String)> = ids
        .into_iter()
        .map(|id| {
            (
                id,
                input.text("body", &["alpha", "bravo", "charlie", "delta"], 1, 3),
            )
        })
        .collect();
    // One note a millisecond, counted from the phase's start.
    let requests: Vec<(Duration, Request)> = posts
        .iter()
        .enumerate()
        .map(|(at, (id, body))| {
            (
                Duration::from_millis(at as u64),
                Request::new(Method::Post, format!("/notes/{id}"))
                    .json(&NewNote { body: body.clone() }),
            )
        })
        .collect();

    let drive = Drive::new(sim, app);
    let phase = drive.faulted_phase(&requests, Duration::from_secs(2))?;
    let Some(recovered) = drive.recover(&phase, Duration::from_secs(60))? else {
        return Ok(None);
    };
    let acked = posts
        .into_iter()
        .enumerate()
        .filter(|(i, _)| phase.status(*i) == Some(200))
        .map(|(_, post)| post)
        .collect();
    Ok(Some((recovered, acked)))
}

/// An acked write is durable: after a crash every acked row is still there.
fn acked_note_survives_a_restart(sim: &mut Sim) -> Result<(), String> {
    let Some((recovered, acked)) = post_then_crash(sim)? else {
        return Ok(());
    };
    if acked.is_empty() {
        sim.give_up("no POST was acked, so durability has nothing to prove", "");
        return Ok(());
    }
    let snap = recovered
        .kernel
        .app()
        .db()
        .snapshot()
        .map_err(|e| e.to_string())?;
    for (id, body) in &acked {
        match snap.get::<Note>(Id::from_raw(*id)) {
            Ok(Some(note)) if note.body == *body => {}
            Ok(Some(note)) => {
                return Err(format!(
                    "acked note {id} came back as {:?}, not the {body:?} it was acked with",
                    note.body
                ));
            }
            // Acked-but-lost is excused ONLY where the harness injected durable
            // corruption into this run (GUIDE §8, "Giving up").
            Ok(None) if durable_corruption_fired(sim) => {
                sim.give_up(
                    "injected durable corruption fired, so the acked row is excused",
                    "",
                );
                return Ok(());
            }
            Ok(None) => return Err(format!("acked note {id} lost across a crash")),
            Err(e) => return Err(e.to_string()),
        }
    }
    Ok(())
}

/// An acked POST implies the job's effect once the queue has drained —
/// through a crash in between, and the tail's minute drains it. Two
/// invariants hold under any fault schedule:
/// - Ack-durability: a 200 from `/notes/:id` committed its enqueue in the
///   same log record, so each acked note has its own `Echo` job row. It is
///   checked note by note, not by count: the tail's re-sent notes add jobs
///   too, and one of theirs must not make up for an acked note's.
/// - Exactly-once: the notes marked `echoed` number exactly the `Echo` jobs
///   that are Done — a job's effect and its Done mark commit as one record.
///   Each add enqueues one `Echo` in the note's own record, so two for one
///   note mean the route added it twice, a cause told apart first.
///
/// It also fails a run in which a job's `on_dead` hook failed
/// (`dead_hooks_succeeded`, GUIDE §8). `Echo` is `retain_dead` and has no
/// hook, so this passes trivially until a job here declares `on_dead`; from
/// then on it fails any run in which that hook failed.
///
/// Delete `tx.enqueue` in `src/lib.rs`, or make `Echo::run` do nothing, and
/// this goes red with a seed.
fn acked_post_implies_the_echo_after_recovery(sim: &mut Sim) -> Result<(), String> {
    let Some((recovered, acked)) = post_then_crash(sim)? else {
        return Ok(());
    };
    let snap = recovered
        .kernel
        .app()
        .db()
        .snapshot()
        .map_err(|e| e.to_string())?;
    dead_hooks_succeeded(&snap)?;
    let echo_jobs: Vec<JobRow> = snap
        .scan::<JobRow>()
        .map_err(|e| e.to_string())?
        .into_iter()
        .filter(|job| job.name == "Echo")
        .collect();
    let mut per_note: BTreeMap<u64, usize> = BTreeMap::new();
    for job in &echo_jobs {
        let echo = Echo::decode(&mut &job.payload[..]).map_err(|e| e.to_string())?;
        *per_note.entry(echo.note.raw()).or_insert(0) += 1;
    }
    if let Some((id, _)) = acked.iter().find(|(id, _)| !per_note.contains_key(id)) {
        // Media corruption can cut a record whose reply was already sent
        // (GUIDE §8, "Giving up"). Only this loss is excused: an
        // exactly-once violation below fails even where corruption fired.
        if durable_corruption_fired(sim) {
            sim.give_up(
                "injected durable corruption fired, so the acked enqueue is excused",
                "",
            );
            return Ok(());
        }
        return Err(format!(
            "ack-durability violated: note {id} was acked with 200 but has no durable Echo job — \
             the enqueue did not commit with the row"
        ));
    }
    if let Some((note, jobs)) = per_note.iter().find(|(_, jobs)| **jobs > 1) {
        return Err(format!(
            "exactly-once violated: note {note} has {jobs} Echo jobs — it was added twice, so it is echoed twice: \
             a re-sent POST /notes/{note} whose first send landed must not enqueue again (src/lib.rs, add_note)"
        ));
    }
    let done = echo_jobs
        .iter()
        .filter(|job| job.status == JobStatus::Done)
        .count();
    let echoed = snap
        .scan::<Note>()
        .map_err(|e| e.to_string())?
        .iter()
        .filter(|note| note.echoed)
        .count();
    if echoed != done {
        return Err(format!(
            "exactly-once violated: {echoed} note(s) read echoed = true but {done} Echo job(s) are Done — \
             a job's effect and its Done mark commit as one record"
        ));
    }
    Ok(())
}

/// An acked POST implies its realtime event: each acked note's `NoteAdded`
/// is in the durable event log exactly once after recovery — the log a
/// subscriber's resume reads. None means the emit did not commit with the
/// row; more than one means the route emitted it again for the same note.
/// Delete `tx.emit` in `src/lib.rs` and this goes red with a seed.
fn acked_post_implies_its_event_after_recovery(sim: &mut Sim) -> Result<(), String> {
    let Some((recovered, acked)) = post_then_crash(sim)? else {
        return Ok(());
    };
    if acked.is_empty() {
        sim.give_up("no POST was acked, so its event has nothing to prove", "");
        return Ok(());
    }
    let snap = recovered
        .kernel
        .app()
        .db()
        .snapshot()
        .map_err(|e| e.to_string())?;
    // Every page of the log, decoded as the app's own type (GUIDE §8, "The
    // checkers").
    let added = events::<NoteAdded>(&snap)?;
    for (id, _) in &acked {
        let seen = added.iter().filter(|e| e.note.raw() == *id).count();
        if seen > 1 {
            return Err(format!(
                "exactly-once violated: note {id} has {seen} NoteAdded events — the route emitted it more than once: \
                 a note emits once, when it is first added, and a repeat of a stored note must not emit again (src/lib.rs, add_note)"
            ));
        }
        if seen == 0 {
            if durable_corruption_fired(sim) {
                sim.give_up(
                    "injected durable corruption fired, so the acked event is excused",
                    "",
                );
                return Ok(());
            }
            return Err(format!(
                "event-durability violated: note {id} was acked with 200 but its NoteAdded is not in the event log — \
                 the emit did not commit with the row"
            ));
        }
    }
    Ok(())
}

/// What `add_note` answers a POST that reuses note 1's id with another body.
const REFUSED: &str = r#"{"error":"note 1 already holds another body — a note is written once; post the new body under a new id"}"#;

/// A repeat changes nothing and a conflict is refused. Note 1 is posted three
/// times in a drawn order, twice with one body and once with another: a
/// client re-sending a POST it never saw answered, and one reusing the id.
/// Whichever body landed first is the note's, through any crash. Each POST
/// with it is answered 200 with the note's id, each with the other is refused
/// with the route's 400, and no repeat adds a second `Echo` job or
/// `NoteAdded` event. A POST's answer is the tail's if the tail re-sent it,
/// else the phase's.
///
/// Turn `==` into `!=` in `add_note` and this goes red with a seed.
fn a_resent_note_changes_nothing_and_a_conflict_is_refused(sim: &mut Sim) -> Result<(), String> {
    let mut bodies = ["alpha", "alpha", "bravo"];
    sim.input().shuffle("order", &mut bodies);
    let requests: Vec<(Duration, Request)> = bodies
        .iter()
        .enumerate()
        .map(|(at, body)| {
            (
                Duration::from_millis(at as u64),
                Request::new(Method::Post, "/notes/1").json(&NewNote {
                    body: body.to_string(),
                }),
            )
        })
        .collect();

    let drive = Drive::new(sim, app);
    let phase = drive.faulted_phase(&requests, Duration::from_secs(2))?;
    let Some(recovered) = drive.recover(&phase, Duration::from_secs(60))? else {
        return Ok(());
    };
    let snap = recovered
        .kernel
        .app()
        .db()
        .snapshot()
        .map_err(|e| e.to_string())?;
    let stored = snap
        .get::<Note>(Id::from_raw(1))
        .map_err(|e| e.to_string())?
        .map(|note| note.body);
    for (i, body) in bodies.iter().enumerate() {
        let got = recovered.resent[i]
            .as_ref()
            .or(phase.answers[i].as_ref())
            .map(|(status, bytes)| format!("{status} {}", String::from_utf8_lossy(bytes)));
        let want = if stored.as_deref() == Some(*body) {
            "200 \"1\"".to_string()
        } else {
            format!("400 {REFUSED}")
        };
        if got.as_ref() == Some(&want) {
            continue;
        }
        // An acked note that media corruption cut leaves an answer the store
        // no longer bears out (GUIDE §8, "Giving up"). Only that is excused.
        if durable_corruption_fired(sim) {
            sim.give_up(
                "injected durable corruption fired, so an acked answer is excused",
                "",
            );
            return Ok(());
        }
        return Err(format!(
            "POST /notes/1 {body:?} was answered {}, not {want}, and note 1 holds {stored:?} — a \
             repeat of the stored body is answered 200 with its id, and another body is refused \
             with a 400 (src/lib.rs, add_note)",
            got.as_deref().unwrap_or("nothing")
        ));
    }
    let echoes = snap
        .scan::<JobRow>()
        .map_err(|e| e.to_string())?
        .iter()
        .filter(|job| job.name == "Echo")
        .count();
    let added = events::<NoteAdded>(&snap)?.len();
    if echoes > 1 || added > 1 {
        return Err(format!(
            "exactly-once violated: note 1 has {echoes} Echo jobs and {added} NoteAdded events — \
             a repeat of a stored note changes nothing, so it must not enqueue or emit again \
             (src/lib.rs, add_note)"
        ));
    }
    Ok(())
}
