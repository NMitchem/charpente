//! Three properties, each honest: each asserts a claim that holds under ANY
//! fault schedule and gives up — rather than passing — in a universe where
//! injected faults stopped it before the claim could be tested (GUIDE §8).
//! The notes, their bodies and their order are drawn with `sim.input()`, so a
//! failure shrinks to the fewest, simplest notes that still fail.
//!
//! Run them: `charpente test --sim`. Watch one fail: delete the `tx.enqueue`
//! line in `src/lib.rs` and run again. Delete `tx.emit` and the third goes red.

use charpente::core::db::Event;
use charpente::core::event::EventRow;
use charpente::core::io::Clock;
use charpente::core::job::{JobRow, JobStatus};
use charpente::core::table::Codec;
use charpente::http::{App, Method, Request};
use charpente::kernel::{Kernel, SimSource};
use charpente::{Id, View};
use charpente_sim::Sim;
use charpente_sim::checks::{
    boot_through_fallout, clock_fallout, clock_reopens_after, durable_corruption_fired,
    is_fault_fallout,
};
use {{ident}}::{NewNote, Note, NoteAdded, build_app};

charpente_sim::sim_tests! {
    acked_note_survives_a_restart require ["restart"],
    acked_post_implies_the_echo_after_recovery require ["restart"],
    acked_post_implies_its_event_after_recovery require ["restart"],
}

const SEC: u64 = 1_000_000_000; // SimSource timestamps are virtual nanoseconds

/// Opens the app on this universe's disk, retrying a boot that faults
/// stopped. A boot refused for durable corruption gives up by name only where
/// the harness injected some; anywhere else it is a durability bug and fails
/// (GUIDE §8). `None` means it never booted, given up by name only for that
/// refusal.
fn open_app(sim: &Sim, fallout: impl Fn(&str) -> bool) -> Result<Option<App>, String> {
    let boot = || build_app(Box::new(sim.disk()), Box::new(sim.entropy()));
    boot_through_fallout(sim, 8, fallout, boot).map_err(|e| e.to_string())
}

/// Runs the production event loop against a scripted source under faults.
/// Fault fallout ends this phase, not the universe: the replies already sent
/// stand, and the tail judges the recovery. The kernel also stops, or refuses
/// to open, on a clock too far behind; that is fallout only where the
/// harness's clock faults fired (`clock_fallout`, GUIDE §8).
fn run_kernel(sim: &Sim, app: App, source: &mut SimSource) -> Result<(), String> {
    let fallout = |text: &str| is_fault_fallout(text) || clock_fallout(sim, text);
    match Kernel::new(app, Box::new(sim.clock())) {
        Ok(mut kernel) => match kernel.run(source) {
            Err(e) if !fallout(&e.to_string()) => Err(e.to_string()),
            _ => Ok(()),
        },
        Err(e) if fallout(&e.to_string()) => Ok(()),
        Err(e) => Err(e.to_string()),
    }
}

/// The recovered kernel and each acked note's id and body.
type Recovered = (Kernel, Vec<(u64, String)>);

/// POST 1-4 drawn notes (bodies and order drawn too) under faults, crash, and
/// recover in a fault-free tail. Returns the recovered kernel and each acked
/// note's id and body — the only notes there is a claim about.
fn post_then_crash(sim: &mut Sim) -> Result<Option<Recovered>, String> {
    let input = sim.input();
    let count = input.between("notes", 1, 4);
    let mut ids: Vec<u64> = (1..=count).collect();
    input.shuffle("order", &mut ids);
    let posts: Vec<(u64, String)> = ids
        .into_iter()
        .map(|id| {
            (
                id,
                input.text("body", &["alpha", "bravo", "charlie", "delta"], 1, 3),
            )
        })
        .collect();

    let Some(app) = open_app(sim, is_fault_fallout)? else {
        if sim.gave_up().is_none() {
            sim.give_up("the app never booted", "");
        }
        return Ok(None);
    };
    let mut source = SimSource::new(Box::new(sim.clock()), 2 * SEC);
    for (at, (id, body)) in posts.iter().enumerate() {
        source.push_at(
            at as u64 * 1_000_000,
            Request::new(Method::Post, format!("/notes/{id}"))
                .json(&NewNote { body: body.clone() }),
        );
    }
    let responses = source.responses();
    run_kernel(sim, app, &mut source)?;
    // The kernel answers in arrival order, one reply per POST.
    let statuses: Vec<u16> = responses
        .lock()
        .map_err(|_| "responses lock poisoned".to_string())?
        .iter()
        .map(|(status, _)| *status)
        .collect();
    let acked: Vec<(u64, String)> = posts
        .into_iter()
        .zip(statuses)
        .filter(|(_, status)| *status == 200)
        .map(|(post, _)| post)
        .collect();
    sim.restart();
    Ok(recover(sim)?.map(|kernel| (kernel, acked)))
}

/// The fault-free tail (GUIDE §8): the faults that cost the claim its ack are
/// over, so the recovery is judged whole. It boots through fallout already armed
/// and waits out only a clock refusal, the one stop a frozen clock cures.
fn recover(sim: &Sim) -> Result<Option<Kernel>, String> {
    sim.quiesce_disk_faults();
    sim.quiesce_clock_faults();
    let fallout = |text: &str| is_fault_fallout(text) || clock_fallout(sim, text);
    let mut waits = 0;
    loop {
        let Some(app) = open_app(sim, fallout)? else {
            // A durable refusal gave the universe up by name; with disk
            // faults off, nothing else should stop a boot.
            return match sim.gave_up() {
                Some(_) => Ok(None),
                None => Err("the fault-free tail could not boot".to_string()),
            };
        };
        let e = match Kernel::new(app, Box::new(sim.clock())) {
            Ok(kernel) => return Ok(Some(kernel)),
            Err(e) => e.to_string(),
        };
        // An earlier step back left the clock behind the time the store
        // recorded: wait past the instant the refusal names, then restart.
        let Some(at) = clock_reopens_after(&e).filter(|_| clock_fallout(sim, &e)) else {
            return Err(e);
        };
        if waits == 2 {
            sim.give_up("the tail was refused after two waits", e);
            return Ok(None);
        }
        waits += 1;
        let wait = at.as_nanos().saturating_sub(sim.clock().wall().as_nanos()) + SEC;
        sim.clock().sleep(std::time::Duration::from_nanos(wait));
        sim.restart_process();
    }
}

/// An acked write is durable: after a crash every acked row is still there.
fn acked_note_survives_a_restart(sim: &mut Sim) -> Result<(), String> {
    let Some((kernel, acked)) = post_then_crash(sim)? else {
        return Ok(());
    };
    if acked.is_empty() {
        sim.give_up("no POST was acked, so durability has nothing to prove", "");
        return Ok(());
    }
    let snap = kernel.app().db().snapshot().map_err(|e| e.to_string())?;
    for (id, body) in &acked {
        match snap.get::<Note>(Id::from_raw(*id)) {
            Ok(Some(note)) if note.body == *body => {}
            Ok(Some(note)) => {
                return Err(format!(
                    "acked note {id} came back as {:?}, not the {body:?} it was acked with",
                    note.body
                ));
            }
            // Acked-but-lost is excused ONLY where the harness injected durable
            // corruption into this universe (GUIDE §8, "Giving up").
            Ok(None) if durable_corruption_fired(sim) => {
                sim.give_up("durable corruption fired, so the acked row is excused", "");
                return Ok(());
            }
            Ok(None) => return Err(format!("acked note {id} lost across a crash")),
            Err(e) => return Err(e.to_string()),
        }
    }
    Ok(())
}

/// An acked POST implies the job's effect once the queue has drained —
/// through a crash in between. Two invariants hold under any fault schedule:
/// - Ack-durability: a 200 from `/notes/:id` committed its enqueue in the
///   same log record, so each acked note has an `Echo` job row.
/// - Exactly-once: the notes marked `echoed` number exactly the `Echo` jobs
///   that are Done — a job's effect and its Done mark commit as one record.
///
/// Delete `tx.enqueue` in `src/lib.rs`, or make `Echo::run` do nothing, and
/// this goes red with a seed.
fn acked_post_implies_the_echo_after_recovery(sim: &mut Sim) -> Result<(), String> {
    let Some((mut kernel, acked)) = post_then_crash(sim)? else {
        return Ok(());
    };
    // No requests this time: the loop just runs whatever is due, then idles.
    let mut idle = SimSource::new(Box::new(sim.clock()), 60 * SEC);
    kernel.run(&mut idle).map_err(|e| e.to_string())?;
    let snap = kernel.app().db().snapshot().map_err(|e| e.to_string())?;
    let echo_jobs: Vec<JobRow> = snap
        .scan::<JobRow>()
        .map_err(|e| e.to_string())?
        .into_iter()
        .filter(|job| job.name == "Echo")
        .collect();
    if echo_jobs.len() < acked.len() {
        // Media corruption can cut a record whose reply was already sent
        // (GUIDE §8, "Giving up"). Only this shortfall is excused: an
        // exactly-once violation below fails even where corruption fired.
        if durable_corruption_fired(sim) {
            sim.give_up(
                "durable corruption fired, so the acked enqueue is excused",
                "",
            );
            return Ok(());
        }
        return Err(format!(
            "ack-durability violated: {} POST(s) were acked with 200 but only {} Echo job(s) are durable — \
             the enqueue did not commit with the row",
            acked.len(),
            echo_jobs.len()
        ));
    }
    let done = echo_jobs
        .iter()
        .filter(|job| job.status == JobStatus::Done)
        .count();
    let echoed = snap
        .scan::<Note>()
        .map_err(|e| e.to_string())?
        .iter()
        .filter(|note| note.echoed)
        .count();
    if echoed != done {
        return Err(format!(
            "exactly-once violated: {echoed} note(s) read echoed = true but {done} Echo job(s) are Done — \
             a job's effect and its Done mark commit as one record"
        ));
    }
    Ok(())
}

/// An acked POST implies its realtime event: each acked note's `NoteAdded`
/// is in the durable event log exactly once after recovery — the log a
/// subscriber's resume reads. Delete `tx.emit` in `src/lib.rs` and this goes
/// red with a seed.
fn acked_post_implies_its_event_after_recovery(sim: &mut Sim) -> Result<(), String> {
    let Some((kernel, acked)) = post_then_crash(sim)? else {
        return Ok(());
    };
    if acked.is_empty() {
        sim.give_up("no POST was acked, so its event has nothing to prove", "");
        return Ok(());
    }
    let rows: Vec<EventRow> = kernel
        .app()
        .db()
        .snapshot()
        .and_then(|snap| snap.scan_from(0, 4096))
        .map_err(|e| e.to_string())?;
    let mut events = Vec::new();
    for row in rows.iter().filter(|row| row.name == NoteAdded::NAME) {
        events.push(
            NoteAdded::decode(&mut &row.payload[..])
                .map_err(|e| e.to_string())?
                .note,
        );
    }
    for (id, _) in &acked {
        let seen = events.iter().filter(|note| note.raw() == *id).count();
        if seen == 1 {
            continue;
        }
        if seen == 0 && durable_corruption_fired(sim) {
            sim.give_up(
                "durable corruption fired, so the acked event is excused",
                "",
            );
            return Ok(());
        }
        return Err(format!(
            "event-durability violated: note {id} was acked with 200 but its NoteAdded is in the event log {seen} time(s), not once — \
             the emit did not commit with the row"
        ));
    }
    Ok(())
}
