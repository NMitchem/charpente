  {"seq":29,"cwd":"/root/holdqueue","command":"rm -f /root/holdqueue/src/probe2.rs; cat > /root/holdqueue/src/lib.rs <<\"RUSTEOF\"\n//! holdqueue: library holds on charpente.\n//!\n//! An operator registers branches and titles and records how many copies of a\n//! title each branch holds. A patron places a hold on a title for pickup at a\n//! branch; the hold waits (`requested`) until a copy at that branch is set\n//! aside for it (`ready`), and then is picked up, expires after seven days\n//! uncollected, or is cancelled. Copies go to holds in placement order.\n//!\n//! The queue itself lives in `queue.rs`; the outbound notification in\n//! `notify.rs`. This file declares the tables, the wire shapes and the routes.\n\npub mod notify;\npub mod queue;\n\nuse charpente::core::io::{Disk, Entropy};\nuse charpente::http::{ApiError, App, AppConfig, Ctx};\nuse charpente::outbound::Host;\nuse charpente::{Id, Schema, Tx, View, Wire, jobs, route, routes, table};\nuse serde::{Deserialize, Serialize};\nuse std::io;\nuse std::time::Duration;\n\npub use notify::{NOTIFY_HOST, NotifyReady};\npub use queue::{HoldState, READY_HOURS, Tick};\n\n/// The subject an operator credential is minted for.\npub const OPERATOR: &str = \"operator\";\n\n/// A patron is known only by id: the subject of their credential is\n/// `patron:<id>`. Not a table: the platform `ApiKey` row is their record.\npub struct Patron;\n\n@[table(global)]\npub struct Branch {\n    pub id: Id<Branch>,\n    pub name: String,\n}\n\n@[table(global)]\npub struct Title {\n    pub id: Id<Title>,\n    pub name: String,\n}\n\n/// How many copies of one title one branch holds, and where they are: set\n/// aside for a ready hold, or out with a patron who picked one up. The rest\n/// are free on the shelf. `slot` is `\"<branch>:<title>\"`.\n@[table(global)]\npub struct Stock {\n    pub id: Id<Stock>,\n    @[index]\n    pub slot: String,\n    pub branch: Id<Branch>,\n    pub title: Id<Title>,\n    pub copies: u32,\n    pub set_aside: u32,\n    pub on_loan: u32,\n}\n\nimpl Stock {\n    /// Copies on the shelf that no hold has and no patron has out.\n    pub fn free(&self) -> u32 {\n        self.copies.saturating_sub(self.set_aside + self.on_loan)\n    }\n}\n\n/// A hold. `placed_seq`, `ready_seq` and `ended_seq` are stamps from one\n/// app-wide sequence, so the order of every placement, readiness and ending\n/// is recorded; `ready_hour` and `ended_hour` are readings of the logical\n/// hour clock (`queue::Clock`).\n@[table(global)]\npub struct Hold {\n    pub id: Id<Hold>,\n    @[index]\n    pub patron: Id<Patron>,\n    pub title: Id<Title>,\n    pub branch: Id<Branch>,\n    @[index]\n    pub slot: String,\n    @[index]\n    pub state: HoldState,\n    pub placed_seq: u64,\n    pub ready_seq: Option<u64>,\n    pub ready_hour: Option<u64>,\n    pub ended_seq: Option<u64>,\n    pub ended_hour: Option<u64>,\n    pub notified: bool,\n}\n\n/// A copy returned to a branch, recorded once under the id the operator desk\n/// gave it, so a re-sent return frees one copy, not two.\n@[table(global)]\npub struct Return {\n    pub id: Id<Return>,\n    pub branch: Id<Branch>,\n    pub title: Id<Title>,\n}\n\n/// The one-time operator bootstrap: present once the first operator key was\n/// minted.\n@[table(global)]\npub struct OperatorSeat {\n    pub id: Id<OperatorSeat>,\n}\nRUSTEOF\nwc -l /root/holdqueue/src/lib.rs"}
  {"seq":31,"cwd":"/root/holdqueue","command":"cat >> /root/holdqueue/src/lib.rs <<\"RUSTEOF\"\n\n// ---- operator routes ---------------------------------------------------\n\n/// Mints the first operator key, once. Every later patron key is minted by an\n/// operator. A second call is refused.\n@[route(POST \"/operator\", public)]\nfn bootstrap_operator(tx: &mut Tx, ctx: &Ctx) -> Result<String, ApiError> {\n    let seat = Id::<OperatorSeat>::from_raw(0);\n    if tx.get(seat)?.is_some() {\n        return Err(ApiError::BadRequest(\n            \"the operator key was already minted: ask an operator to mint you a key\".to_string(),\n        ));\n    }\n    tx.put(&OperatorSeat { id: seat });\n    Ok(ctx.create_api_key(tx, OPERATOR.to_string()))\n}\n\n/// An operator mints a key for a patron.\n@[route(POST \"/patrons/:patron/keys\", auth)]\nfn mint_patron_key(tx: &mut Tx, patron: Id<Patron>, ctx: &Ctx) -> Result<String, ApiError> {\n    require_operator(ctx)?;\n    Ok(ctx.create_api_key(tx, patron_subject(patron)))\n}\n\n/// Registers (or renames) a branch.\n@[route(PUT \"/branches/:branch\", auth)]\nfn put_branch(tx: &mut Tx, branch: Id<Branch>, body: NameBody, ctx: &Ctx) -> Result<Id<Branch>, ApiError> {\n    require_operator(ctx)?;\n    tx.put(&Branch {\n        id: branch,\n        name: body.name,\n    });\n    Ok(branch)\n}\n\n/// Registers (or renames) a title.\n@[route(PUT \"/titles/:title\", auth)]\nfn put_title(tx: &mut Tx, title: Id<Title>, body: NameBody, ctx: &Ctx) -> Result<Id<Title>, ApiError> {\n    require_operator(ctx)?;\n    tx.put(&Title {\n        id: title,\n        name: body.name,\n    });\n    Ok(title)\n}\n\n/// Records how many copies of `title` `branch` holds. Raising the count frees\n/// copies, which go to the waiting holds in placement order.\n@[route(PUT \"/branches/:branch/titles/:title/copies\", auth)]\nfn put_copies(\n    tx: &mut Tx,\n    branch: Id<Branch>,\n    title: Id<Title>,\n    body: CopiesBody,\n    ctx: &Ctx,\n) -> Result<StockView, ApiError> {\n    require_operator(ctx)?;\n    Ok(queue::set_copies(tx, branch, title, body.copies)?.into())\n}\n\n/// A copy of `title` came back to `branch`, recorded under the return id.\n@[route(POST \"/returns/:id\", auth)]\nfn record_return(tx: &mut Tx, id: Id<Return>, body: ReturnBody, ctx: &Ctx) -> Result<StockView, ApiError> {\n    require_operator(ctx)?;\n    Ok(queue::record_return(tx, id, body.branch, body.title)?.into())\n}\n\n/// The holds waiting on `title` at `branch`, in the order they will be served.\n@[route(GET \"/branches/:branch/titles/:title/queue\", auth)]\nfn waiting_queue(tx: &mut Tx, branch: Id<Branch>, title: Id<Title>, ctx: &Ctx) -> Result<HoldList, ApiError> {\n    require_operator(ctx)?;\n    let holds = queue::waiting(tx, branch, title)?;\n    Ok(HoldList {\n        holds: holds.into_iter().map(HoldView::from).collect(),\n    })\n}\n\n/// The patron collected the copy set aside for this hold (recorded at the\n/// desk, by an operator).\n@[route(POST \"/holds/:id/pickup\", auth)]\nfn pick_up(tx: &mut Tx, id: Id<Hold>, ctx: &Ctx) -> Result<HoldView, ApiError> {\n    require_operator(ctx)?;\n    Ok(queue::pick_up(tx, id)?.into())\n}\n\n// ---- patron routes -----------------------------------------------------\n\n/// Places a hold under the id the patron client chose. The same request\n/// again is answered with the hold as it stands and changes nothing; the same\n/// id with another title, branch or patron is a conflict.\n@[route(POST \"/holds/:id\", auth)]\nfn place_hold(tx: &mut Tx, id: Id<Hold>, body: HoldBody, ctx: &Ctx) -> Result<HoldView, ApiError> {\n    let patron = require_patron(ctx)?;\n    Ok(queue::place(tx, id, patron, body.title, body.branch)?.into())\n}\n\n/// The patron withdraws a hold they have not picked up.\n@[route(POST \"/holds/:id/cancel\", auth)]\nfn cancel_hold(tx: &mut Tx, id: Id<Hold>, ctx: &Ctx) -> Result<HoldView, ApiError> {\n    let patron = require_patron(ctx)?;\n    Ok(queue::cancel(tx, id, patron)?.into())\n}\n\n/// The holds of the caller, each with its state, in id order.\n@[route(GET \"/holds\", auth)]\nfn my_holds(tx: &mut Tx, ctx: &Ctx) -> Result<HoldList, ApiError> {\n    let patron = require_patron(ctx)?;\n    let holds = Hold::by_patron(tx, &patron)?;\n    Ok(HoldList {\n        holds: holds.into_iter().map(HoldView::from).collect(),\n    })\n}\n\n/// One hold of the caller. A hold of another patron reads as absent.\n@[route(GET \"/holds/:id\", auth)]\nfn my_hold(tx: &mut Tx, id: Id<Hold>, ctx: &Ctx) -> Result<HoldView, ApiError> {\n    let patron = require_patron(ctx)?;\n    match tx.get(id)? {\n        Some(h) if h.patron == patron => Ok(h.into()),\n        _ => Err(ApiError::NotFound),\n    }\n}\n\n/// How often the logical hour clock ticks (and expiry is swept).\npub const TICK_EVERY: Duration = Duration::from_secs(3600);\n\n/// The app, in the shape `charpente::launch` and the sim both take.\npub fn build_app(disk: Box<dyn Disk>, entropy: Box<dyn Entropy>) -> io::Result<App> {\n    Ok(App::open(\n        disk,\n        Schema::new()\n            .table::<Branch>()\n            .table::<Title>()\n            .table::<Stock>()\n            .table::<Hold>()\n            .table::<Return>()\n            .table::<OperatorSeat>()\n            .table::<queue::Counter>()\n            .table::<queue::Clock>(),\n        entropy,\n        AppConfig::default(),\n    )?\n    .mount(routes![\n        bootstrap_operator,\n        mint_patron_key,\n        put_branch,\n        put_title,\n        put_copies,\n        record_return,\n        waiting_queue,\n        pick_up,\n        place_hold,\n        cancel_hold,\n        my_holds,\n        my_hold\n    ])\n    .mount_jobs(jobs![Tick, NotifyReady])\n    .schedule(\"hour\", TICK_EVERY, || Tick {})\n    .outbound(Host::new(NOTIFY_HOST).bearer_env(\"NOTIFY_TOKEN\")))\n}\nRUSTEOF\nsed -i \"s/^\\( *\\)@\\[/\\1#[/\" /root/holdqueue/src/lib.rs; grep -c \"#\\[\" /root/holdqueue/src/lib.rs; wc -l /root/holdqueue/src/lib.rs"}
  {"seq":32,"cwd":"/root/holdqueue","command":"cat > /root/holdqueue/src/queue.rs <<\"RUSTEOF\"\n//! The hold queue: the state machine, the allocation of free copies to\n//! waiting holds in placement order, and the hourly tick that expires holds\n//! left uncollected for seven days.\n//!\n//! Every function here runs inside the transaction of the route or job that\n//! calls it, so a state change, the copy accounting it implies, the holds it\n//! makes ready and their notification jobs commit as one record.\n\nuse crate::notify::NotifyReady;\nuse crate::{Branch, Hold, Patron, Return, Stock, Title};\nuse charpente::core::table::Codec;\nuse charpente::http::ApiError;\nuse charpente::kernel::JobError;\nuse charpente::{Id, Tx, View, job, table};\nuse std::collections::BTreeSet;\nuse std::io;\n\n/// How long a ready hold waits for its patron, in ticks of the logical hour\n/// clock: seven days. A hold made ready at hour `h` expires at the first tick\n/// past `h + READY_HOURS`, so it has been ready for at least seven days.\npub const READY_HOURS: u64 = 7 * 24;\n\n/// Where a hold is in its life.\n@[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum HoldState {\n    /// Placed, waiting for a copy.\n    Requested,\n    /// A copy at the pickup branch is set aside for it.\n    Ready,\n    /// The patron collected the copy.\n    PickedUp,\n    /// Ready for seven days and nobody collected it.\n    Expired,\n    /// The patron withdrew it before picking it up.\n    Cancelled,\n}\n\nimpl HoldState {\n    /// The name a patron or operator reads.\n    pub fn name(&self) -> &str {\n        match self {\n            HoldState::Requested => \"requested\",\n            HoldState::Ready => \"ready for pickup\",\n            HoldState::PickedUp => \"picked up\",\n            HoldState::Expired => \"expired\",\n            HoldState::Cancelled => \"cancelled\",\n        }\n    }\n\n    /// The transitions allowed from this state, as a refusal names them.\n    pub fn allowed(&self) -> &str {\n        match self {\n            HoldState::Requested => {\n                \"become ready (when a copy is set aside for it), cancel (by its patron)\"\n            }\n            HoldState::Ready => {\n                \"pick up (by an operator), cancel (by its patron), expire (after 7 days uncollected)\"\n            }\n            HoldState::PickedUp | HoldState::Expired | HoldState::Cancelled => {\n                \"none, because this state is final\"\n            }\n        }\n    }\n}\n\nimpl Codec for HoldState {\n    fn encode(&self, out: &mut Vec<u8>) {\n        let tag: u8 = match self {\n            HoldState::Requested => 0,\n            HoldState::Ready => 1,\n            HoldState::PickedUp => 2,\n            HoldState::Expired => 3,\n            HoldState::Cancelled => 4,\n        };\n        tag.encode(out);\n    }\n\n    fn decode(input: &mut &[u8]) -> io::Result<Self> {\n        match u8::decode(input)? {\n            0 => Ok(HoldState::Requested),\n            1 => Ok(HoldState::Ready),\n            2 => Ok(HoldState::PickedUp),\n            3 => Ok(HoldState::Expired),\n            4 => Ok(HoldState::Cancelled),\n            other => Err(io::Error::other(format!(\n                \"invalid HoldState tag {other}: schema drift or corruption\"\n            ))),\n        }\n    }\n}\n\n/// Counter rows, one per id space (GUIDE section 2, \"Generating ids\").\n@[table(global)]\npub struct Counter {\n    pub id: Id<Counter>,\n    pub next: u64,\n}\n\n/// The id space of `Stock` rows.\npub const STOCK_IDS: u64 = 0;\n/// The app-wide sequence that stamps placements, readiness and endings.\npub const EVENT_SEQ: u64 = 1;\n\n/// Draws the next value of counter `which`, starting at 1.\npub fn next(tx: &mut Tx, which: u64) -> io::Result<u64> {\n    let id = Id::<Counter>::from_raw(which);\n    let mut counter = tx.get(id)?.unwrap_or(Counter { id, next: 1 });\n    let value = counter.next;\n    counter.next += 1;\n    tx.put(&counter);\n    Ok(value)\n}\n\n/// The logical hour clock: a singleton row only `Tick` advances (GUIDE\n/// section 7, \"A logical clock\").\n@[table(global)]\npub struct Clock {\n    pub id: Id<Clock>,\n    pub hour: u64,\n}\n\n/// The current reading of the logical hour clock (0 before the first tick).\npub fn hour(view: &impl View) -> io::Result<u64> {\n    Ok(view.get(Id::<Clock>::from_raw(0))?.map_or(0, |c| c.hour))\n}\n\n/// True once a hold made ready at `ready_hour` has waited seven days at\n/// `now_hour`.\npub fn overdue(ready_hour: u64, now_hour: u64) -> bool {\n    now_hour > ready_hour + READY_HOURS\n}\n\n/// The index key of one title at one branch.\npub fn slot_key(branch: Id<Branch>, title: Id<Title>) -> String {\n    format!(\"{}:{}\", branch.raw(), title.raw())\n}\n\n/// The stock row of `title` at `branch`, if the operator recorded one.\npub fn find_stock(view: &impl View, branch: Id<Branch>, title: Id<Title>) -> io::Result<Option<Stock>> {\n    Ok(Stock::by_slot(view, &slot_key(branch, title))?.into_iter().next())\n}\n\n/// The requested holds on `title` at `branch`, earliest placed first: the\n/// order copies go to them.\npub fn waiting(view: &impl View, branch: Id<Branch>, title: Id<Title>) -> io::Result<Vec<Hold>> {\n    let mut holds: Vec<Hold> = Hold::by_slot(view, &slot_key(branch, title))?\n        .into_iter()\n        .filter(|h| h.state == HoldState::Requested)\n        .collect();\n    holds.sort_by_key(|h| h.placed_seq);\n    Ok(holds)\n}\nRUSTEOF\nwc -l /root/holdqueue/src/queue.rs"}
  {"seq":33,"cwd":"/root/holdqueue","command":"cat >> /root/holdqueue/src/queue.rs <<\"RUSTEOF\"\n\n/// Gives every free copy of `title` at `branch` to the earliest-placed\n/// requested holds, one copy each, and enqueues each such hold its\n/// notification in the same transaction. Returns the stock as it now stands.\npub fn serve(tx: &mut Tx, branch: Id<Branch>, title: Id<Title>) -> io::Result<Option<Stock>> {\n    let Some(mut stock) = find_stock(&*tx, branch, title)? else {\n        return Ok(None);\n    };\n    let now = hour(&*tx)?;\n    for mut hold in waiting(&*tx, branch, title)? {\n        if stock.free() == 0 {\n            break;\n        }\n        hold.state = HoldState::Ready;\n        hold.ready_seq = Some(next(tx, EVENT_SEQ)?);\n        hold.ready_hour = Some(now);\n        stock.set_aside += 1;\n        tx.put(&hold);\n        tx.enqueue(NotifyReady { hold: hold.id });\n    }\n    tx.put(&stock);\n    Ok(Some(stock))\n}\n\nfn no_branch(branch: Id<Branch>) -> ApiError {\n    ApiError::BadRequest(format!(\n        \"no branch {0}: an operator registers it first with PUT /branches/{0}\",\n        branch.raw()\n    ))\n}\n\nfn no_title(title: Id<Title>) -> ApiError {\n    ApiError::BadRequest(format!(\n        \"no title {0}: an operator registers it first with PUT /titles/{0}\",\n        title.raw()\n    ))\n}\n\n/// A refusal of a transition the state machine does not allow, by name, with\n/// the transitions that are allowed from the state the hold is in.\npub fn refuse(id: Id<Hold>, verb: &str, state: HoldState) -> ApiError {\n    ApiError::BadRequest(format!(\n        \"transition refused: cannot {verb} hold {}, which is {}; from {} the allowed transitions are: {}\",\n        id.raw(),\n        state.name(),\n        state.name(),\n        state.allowed()\n    ))\n}\n\n/// Records that `branch` holds `copies` copies of `title`. A count below the\n/// copies already set aside or out is refused. New free copies are served.\npub fn set_copies(tx: &mut Tx, branch: Id<Branch>, title: Id<Title>, copies: u32) -> Result<Stock, ApiError> {\n    if tx.get(branch)?.is_none() {\n        return Err(no_branch(branch));\n    }\n    if tx.get(title)?.is_none() {\n        return Err(no_title(title));\n    }\n    let mut stock = match find_stock(&*tx, branch, title)? {\n        Some(stock) => stock,\n        None => Stock {\n            id: Id::from_raw(next(tx, STOCK_IDS)?),\n            slot: slot_key(branch, title),\n            branch,\n            title,\n            copies: 0,\n            set_aside: 0,\n            on_loan: 0,\n        },\n    };\n    if copies < stock.set_aside + stock.on_loan {\n        return Err(ApiError::BadRequest(format!(\n            \"branch {} cannot hold {copies} copies of title {}: {} are set aside for ready holds and {} are out with patrons; record a count of at least {}\",\n            branch.raw(),\n            title.raw(),\n            stock.set_aside,\n            stock.on_loan,\n            stock.set_aside + stock.on_loan\n        )));\n    }\n    stock.copies = copies;\n    tx.put(&stock);\n    Ok(serve(tx, branch, title)?.unwrap_or(stock))\n}\n\n/// Places hold `id` for `patron` on `title` at `branch`. A repeat of the same\n/// placement answers the hold as it stands; another placement under the same\n/// id is refused as a conflict.\npub fn place(\n    tx: &mut Tx,\n    id: Id<Hold>,\n    patron: Id<Patron>,\n    title: Id<Title>,\n    branch: Id<Branch>,\n) -> Result<Hold, ApiError> {\n    if let Some(hold) = tx.get(id)? {\n        if hold.patron == patron && hold.title == title && hold.branch == branch {\n            return Ok(hold);\n        }\n        return Err(ApiError::BadRequest(format!(\n            \"hold {} already names another patron, title or branch: a hold id names one hold; place the new hold under a new id\",\n            id.raw()\n        )));\n    }\n    if tx.get(branch)?.is_none() {\n        return Err(no_branch(branch));\n    }\n    if tx.get(title)?.is_none() {\n        return Err(no_title(title));\n    }\n    let placed_seq = next(tx, EVENT_SEQ)?;\n    tx.put(&Hold {\n        id,\n        patron,\n        title,\n        branch,\n        slot: slot_key(branch, title),\n        state: HoldState::Requested,\n        placed_seq,\n        ready_seq: None,\n        ready_hour: None,\n        ended_seq: None,\n        ended_hour: None,\n        notified: false,\n    });\n    serve(tx, branch, title)?;\n    tx.get(id)?\n        .ok_or_else(|| ApiError::Internal(format!(\"hold {} vanished inside its own transaction\", id.raw())))\n}\n\n/// Ends `hold` in `state`, stamping when.\nfn end(tx: &mut Tx, hold: &mut Hold, state: HoldState) -> io::Result<()> {\n    hold.state = state;\n    hold.ended_seq = Some(next(tx, EVENT_SEQ)?);\n    hold.ended_hour = Some(hour(&*tx)?);\n    tx.put(&*hold);\n    Ok(())\n}\n\n/// The stock a ready or picked-up hold draws on. It always exists: a hold\n/// becomes ready only from a stock row.\nfn stock_of(tx: &Tx, hold: &Hold) -> Result<Stock, ApiError> {\n    find_stock(tx, hold.branch, hold.title)?.ok_or_else(|| {\n        ApiError::Internal(format!(\n            \"hold {} drew a copy, but branch {} has no stock of title {}\",\n            hold.id.raw(),\n            hold.branch.raw(),\n            hold.title.raw()\n        ))\n    })\n}\n\n/// The patron collected the copy set aside for hold `id`. A repeat of a\n/// pickup answers the hold as it stands.\npub fn pick_up(tx: &mut Tx, id: Id<Hold>) -> Result<Hold, ApiError> {\n    let mut hold = tx.get(id)?.ok_or(ApiError::NotFound)?;\n    match hold.state {\n        HoldState::Ready => {\n            let mut stock = stock_of(tx, &hold)?;\n            stock.set_aside -= 1;\n            stock.on_loan += 1;\n            tx.put(&stock);\n            end(tx, &mut hold, HoldState::PickedUp)?;\n            Ok(hold)\n        }\n        HoldState::PickedUp => Ok(hold),\n        other => Err(refuse(id, \"pick up\", other)),\n    }\n}\n\n/// `patron` withdraws hold `id`. A ready hold gives its copy to the next\n/// hold in line. A repeat of a cancel answers the hold as it stands; the hold\n/// of another patron reads as absent.\npub fn cancel(tx: &mut Tx, id: Id<Hold>, patron: Id<Patron>) -> Result<Hold, ApiError> {\n    let mut hold = match tx.get(id)? {\n        Some(hold) if hold.patron == patron => hold,\n        _ => return Err(ApiError::NotFound),\n    };\n    match hold.state {\n        HoldState::Requested => {\n            end(tx, &mut hold, HoldState::Cancelled)?;\n            Ok(hold)\n        }\n        HoldState::Ready => {\n            let mut stock = stock_of(tx, &hold)?;\n            stock.set_aside -= 1;\n            tx.put(&stock);\n            end(tx, &mut hold, HoldState::Cancelled)?;\n            serve(tx, hold.branch, hold.title)?;\n            Ok(hold)\n        }\n        HoldState::Cancelled => Ok(hold),\n        other => Err(refuse(id, \"cancel\", other)),\n    }\n}\n\n/// A copy of `title` came back to `branch`: it is free again and goes to the\n/// next hold in line. Recorded once under `id`.\npub fn record_return(tx: &mut Tx, id: Id<Return>, branch: Id<Branch>, title: Id<Title>) -> Result<Stock, ApiError> {\n    if let Some(done) = tx.get(id)? {\n        if done.branch == branch && done.title == title {\n            return find_stock(&*tx, branch, title)?\n                .ok_or_else(|| ApiError::Internal(format!(\"return {} has no stock\", id.raw())));\n        }\n        return Err(ApiError::BadRequest(format!(\n            \"return {} already names another branch or title: record the new return under a new id\",\n            id.raw()\n        )));\n    }\n    let mut stock = find_stock(&*tx, branch, title)?.ok_or_else(|| {\n        ApiError::BadRequest(format!(\n            \"branch {} holds no copies of title {}: a copy is returned to the branch it was picked up from\",\n            branch.raw(),\n            title.raw()\n        ))\n    })?;\n    if stock.on_loan == 0 {\n        return Err(ApiError::BadRequest(format!(\n            \"no copy of title {} is out from branch {}: a copy is returned to the branch it was picked up from\",\n            title.raw(),\n            branch.raw()\n        )));\n    }\n    stock.on_loan -= 1;\n    tx.put(&stock);\n    tx.put(&Return { id, branch, title });\n    Ok(serve(tx, branch, title)?.unwrap_or(stock))\n}\n\n/// One tick of the logical hour clock: advance it, expire every ready hold\n/// that has waited seven days, and serve the copies that frees.\npub fn tick(tx: &mut Tx) -> io::Result<()> {\n    let id = Id::<Clock>::from_raw(0);\n    let mut clock = tx.get(id)?.unwrap_or(Clock { id, hour: 0 });\n    clock.hour += 1;\n    tx.put(&clock);\n    let mut freed: BTreeSet<(u64, u64)> = BTreeSet::new();\n    for mut hold in Hold::by_state(&*tx, &HoldState::Ready)? {\n        let Some(ready_hour) = hold.ready_hour else {\n            continue;\n        };\n        if !overdue(ready_hour, clock.hour) {\n            continue;\n        }\n        if let Some(mut stock) = find_stock(&*tx, hold.branch, hold.title)? {\n            stock.set_aside -= 1;\n            tx.put(&stock);\n        }\n        end(tx, &mut hold, HoldState::Expired)?;\n        freed.insert((hold.branch.raw(), hold.title.raw()));\n    }\n    for (branch, title) in freed {\n        serve(tx, Id::from_raw(branch), Id::from_raw(title))?;\n    }\n    Ok(())\n}\n\n/// The cron job behind the logical hour clock.\n@[job(global)]\npub struct Tick {}\n\nimpl Tick {\n    pub fn run(self, tx: &mut Tx) -> Result<(), JobError> {\n        tick(tx)?;\n        Ok(())\n    }\n}\nRUSTEOF\nsed -i \"s/^\\( *\\)@\\[/\\1#[/\" /root/holdqueue/src/queue.rs; wc -l /root/holdqueue/src/queue.rs"}
  {"seq":34,"cwd":"/root/holdqueue","command":"cat > /root/holdqueue/src/notify.rs <<\"RUSTEOF\"\n//! Telling a patron their hold is ready, through the outside messaging\n//! service at `notify.example.org`.\n//!\n//! The job is enqueued in the transaction that makes the hold ready (see\n//! `queue::serve`), so a hold is ready exactly when its notification is\n//! queued. The kernel sends the message after commit with an idempotency key\n//! it minted for this job, the same key on every retry, so a service that\n//! honours it delivers one message per ready hold.\n\nuse crate::{Hold, Patron};\nuse charpente::kernel::JobError;\nuse charpente::outbound::{Call, IdempotencyKey, Reply};\nuse charpente::{Id, Tx, View, job};\nuse serde::Serialize;\n\n/// The messaging service host. The `#[job]` attribute below repeats it as a\n/// literal, which the macro requires.\npub const NOTIFY_HOST: &str = \"notify.example.org\";\n\n/// Tells the patron of `hold` that a copy is set aside for them.\n@[job(\n    global,\n    outbound = \"notify.example.org\",\n    retry(max = 12, backoff = \"2s\"),\n    timeout = \"10s\"\n)]\npub struct NotifyReady {\n    pub hold: Id<Hold>,\n}\n\n/// The message the service delivers, naming the title and the branch.\n@[derive(Serialize)]\npub struct ReadyMessage {\n    pub patron: Id<Patron>,\n    pub hold: Id<Hold>,\n    pub title: String,\n    pub branch: String,\n    pub text: String,\n}\n\nimpl NotifyReady {\n    pub fn call(&self, tx: &Tx, key: &IdempotencyKey) -> Result<Option<Call>, JobError> {\n        let Some(hold) = tx.get(self.hold)? else {\n            return Ok(None);\n        };\n        let title = tx\n            .get(hold.title)?\n            .map_or_else(|| format!(\"title {}\", hold.title.raw()), |t| t.name);\n        let branch = tx\n            .get(hold.branch)?\n            .map_or_else(|| format!(\"branch {}\", hold.branch.raw()), |b| b.name);\n        let text = format!(\"Your hold on {title} is ready for pickup at {branch}.\");\n        let message = ReadyMessage {\n            patron: hold.patron,\n            hold: hold.id,\n            title,\n            branch,\n            text,\n        };\n        Ok(Some(\n            Call::post(\"/messages\")\n                .header(\"idempotency-key\", key.as_str())\n                .json(&message),\n        ))\n    }\n\n    pub fn settle(self, tx: &mut Tx, reply: Reply) -> Result<(), JobError> {\n        let status = reply.status();\n        if !(200..300).contains(&status) {\n            return Err(JobError::app(format!(\"{NOTIFY_HOST} answered {status}\")));\n        }\n        if let Some(mut hold) = tx.get(self.hold)? {\n            hold.notified = true;\n            tx.put(&hold);\n        }\n        Ok(())\n    }\n}\nRUSTEOF\nsed -i \"s/^\\( *\\)@\\[/\\1#[/\" /root/holdqueue/src/notify.rs; cd /root/holdqueue && cargo build 2>&1 | grep -E \"^(error|warning)|-->\" | head -50; cargo build 2>&1 | tail -3"}
  {"seq":36,"cwd":"/root/holdqueue","command":"cd /root/holdqueue && python3 - <<\"PY\"\np=\"src/lib.rs\"; s=open(p).read()\ns=s.replace(\"\"\"/// A patron is known only by id: the subject of their credential is\n/// `patron:<id>`. Not a table: the platform `ApiKey` row is their record.\npub struct Patron;\n\"\"\",\"\"\"/// A patron, known by id: the subject of their credential is `patron:<id>`.\n/// A table only because `Id<T>` crosses the wire just for a `Row` type `T`\n/// (GUIDE section 5 says any `T`; the compiler disagrees). The row is written\n/// when an operator mints the patron a key.\n@[table(global)]\npub struct Patron {\n    pub id: Id<Patron>,\n}\n\"\"\")\ns=s.replace(\"\"\"    require_operator(ctx)?;\n    Ok(ctx.create_api_key(tx, patron_subject(patron)))\"\"\",\"\"\"    require_operator(ctx)?;\n    tx.put(&Patron { id: patron });\n    Ok(ctx.create_api_key(tx, patron_subject(patron)))\"\"\")\ns=s.replace(\"\"\"            .table::<OperatorSeat>()\n\"\"\",\"\"\"            .table::<OperatorSeat>()\n            .table::<Patron>()\n\"\"\")\nopen(p,\"w\").write(s)\nPY\nsed -i \"s/^\\( *\\)@\\[/\\1#[/\" src/lib.rs\ncargo build 2>&1 | grep -E \"^(error|warning)\" -A12 | head -60; cargo build 2>&1 | tail -2"}
  {"seq":37,"cwd":"/root/holdqueue","command":"sed -n 20,66p /opt/registry/charpente-0.4.0/examples/api.rs; sed -n 1000,1060p /opt/registry/charpente-0.4.0/examples/api.rs; ls /opt/registry | grep -E \"sha2|serde_json|hex\""}
